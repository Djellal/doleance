@page "/login"
@layout LoginLayout
@inherits Doleance.Pages.LoginComponent

@using Radzen
@using Radzen.Blazor
@using Doleance.Models.AppDb
@using Microsoft.AspNetCore.Identity;
@using Doleance.Models
@using Microsoft.AspNetCore.Authorization
<PageTitle>Login</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <RadzenHeading Size="H2" Text="Connexion">
    </RadzenHeading>
    <div  class="row">
      <div class="col-md-12">
        <RadzenTemplateForm Action="account/login" Data="@("login")" Method="post" style="width: 100%">
          <ChildContent>
            <RadzenLogin AllowResetPassword="false" LoginText="Connexion" PasswordRequired="Mot de passe requis" PasswordText="Mot de passe" RegisterMessageText="Vous n'avez pas encore de compte?" RegisterText="S'inscrire" ResetPasswordText="Mot de passe oublié ?" style="border: 2px solid #5d717b; border-radius: 10px; padding-bottom: 10px; padding-left: 20px; padding-right: 20px; padding-top: 20px; width: 100%" UserText="Email" Register="@Login0Register" ResetPassword="@Login0ResetPassword">
            </RadzenLogin>
          </ChildContent>
        </RadzenTemplateForm>
      </div>
    </div>
  </ChildContent>
</RadzenContent>
