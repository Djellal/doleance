@page "/account"
@layout MainLayout
@inherits Doleance.Pages.AccountComponent

@using Radzen
@using Radzen.Blazor
@using Doleance.Models.AppDb
@using Microsoft.AspNetCore.Identity;
@using Doleance.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<PageTitle>Account</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <RadzenHeading Size="H2" style="background-color: #598087; color: #e6ecef; text-align: center" Text="Profil">
    </RadzenHeading>
    <div class="row">
      <div class="col-md-12">
        <RadzenTemplateForm Action="account/UpdateProfile" Data="@user" TItem="ApplicationUser" Method="post" Visible="@(user != null)">
          <ChildContent>
            <RadzenCard style="border: 1px solid #000000; border-radius: 10px">
              <ChildContent>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-2">
                    <RadzenLabel Component="Nom" style="width: 100%" Text="Nom & Prénom">
                    </RadzenLabel>
                  </div>
                  <div class="col-md-9">
                    <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(user.Nom)" Name="Nom">
                    </RadzenTextBox>
                    <RadzenRequiredValidator Component="UserName" style="position: absolute" Text="Le nom est requis">
                    </RadzenRequiredValidator>
                  </div>
                </div>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-2">
                    <RadzenLabel Component="Qualite" style="width: 100%" Text="Qualité">
                    </RadzenLabel>
                  </div>
                  <div class="col-md-9">
                    <RadzenDropDown Data="@getQualitesResult" style="width: 100%" TextProperty="Designation" @bind-Value="@(user.Qualite)" ValueProperty="Designation" Name="Qualite">
                    </RadzenDropDown>
                  </div>
                </div>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-2">
                    <RadzenLabel Component="Qualite" style="width: 100%" Text="Affiliation">
                    </RadzenLabel>
                  </div>
                  <div class="col-md-9">
                    <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(user.Affiliation)" Name="Affiliation">
                    </RadzenTextBox>
                  </div>
                </div>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-2">
                    <RadzenLabel Component="userName" style="width: 100%" Text="Email">
                    </RadzenLabel>
                  </div>
                  <div class="col-md-9">
                    <RadzenTextBox Disabled="true" style="display: block; width: 100%" @bind-Value="@(user.Name)" Name="UserName">
                    </RadzenTextBox>
                    <RadzenRequiredValidator Component="UserName" style="position: absolute" Text="L'email est requis">
                    </RadzenRequiredValidator>
                  </div>
                </div>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-2">
                    <RadzenLabel Component="textbox0" style="width: 100%" Text="Tél">
                    </RadzenLabel>
                  </div>
                  <div class="col-md-9">
                    <RadzenTextBox Disabled="true" style="display: block; width: 100%" @bind-Value="@(user.PhoneNumber)" Name="Textbox0">
                    </RadzenTextBox>
                  </div>
                </div>
              </ChildContent>
            </RadzenCard>
            <RadzenCard style="border: 1px solid #000000; border-radius: 10px">
              <ChildContent>
                <div class="row">
                  <div class="col  justify-content-around d-flex">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Modifier">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" Text="Annuler" Click="@Button1Click">
                    </RadzenButton>
                  </div>
                </div>
              </ChildContent>
            </RadzenCard>
          </ChildContent>
        </RadzenTemplateForm>
      </div>
    </div>
  </ChildContent>
</RadzenContent>
