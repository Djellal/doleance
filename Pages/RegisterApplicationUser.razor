@page "/register-application-user"
@layout MainLayout
@inherits Doleance.Pages.RegisterApplicationUserComponent

@using Radzen
@using Radzen.Blazor
@using Doleance.Models.AppDb
@using Microsoft.AspNetCore.Identity;
@using Doleance.Models
@using Microsoft.AspNetCore.Authorization
<PageTitle>Register Application User</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <div class="row">
      <div class="col-md-12">
        <RadzenTemplateForm Action="account/RegisterUser" Data="@user" TItem="ApplicationUser" Method="post" Visible="@(user != null)">
          <ChildContent>
            <RadzenCard style="border: 1px solid #000000; border-radius: 10px">
              <ChildContent>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-12">
                    <RadzenLabel Component="Nom" style="width: 100%" Text="Nom & prénom">
                    </RadzenLabel>
                    <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(user.Nom)" Name="Nom">
                    </RadzenTextBox>
                    <RadzenRequiredValidator Component="UserName" style="position: absolute" Text="Le nom est requis">
                    </RadzenRequiredValidator>
                  </div>
                </div>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-12">
                    <RadzenLabel Component="userName" style="width: 100%" Text="Email">
                    </RadzenLabel>
                    <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(user.Name)" Name="UserName">
                    </RadzenTextBox>
                    <RadzenEmailValidator Component="UserName" Text="Veillez saisir un email valide">
                    </RadzenEmailValidator>
                    <RadzenRequiredValidator Component="UserName" style="position: absolute" Text="L'email est requis">
                    </RadzenRequiredValidator>
                  </div>
                </div>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-12">
                    <RadzenLabel Component="textbox0" style="width: 100%" Text="Tél">
                    </RadzenLabel>
                    <RadzenTextBox Disabled="false" style="display: block; width: 100%" @bind-Value="@(user.PhoneNumber)" Name="Textbox0">
                    </RadzenTextBox>
                  </div>
                </div>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="align-items-center d-flex col-md-12">
                    <RadzenCheckBox style="margin-right: 5px" @bind-Value="@(user.Memberofufas)" Name="Checkbox0">
                    </RadzenCheckBox>
                    <RadzenLabel Text="Membre de la communauté de L'UFAS">
                    </RadzenLabel>
                  </div>
                </div>
                <RadzenCard Visible="@(user.Memberofufas)">
                  <ChildContent>
                    <div style="margin-bottom: 1rem" class="row">
                      <div class="col-md-12">
                        <RadzenLabel Component="Qualite" style="width: 100%" Text="Qualité">
                        </RadzenLabel>
                        <RadzenDropDown Data="@getQualitesResult" style="width: 100%" TextProperty="Designation" @bind-Value="@(user.Qualite)" ValueProperty="Designation" Name="Qualite">
                        </RadzenDropDown>
                      </div>
                    </div>
                    <div style="margin-bottom: 1rem" class="row">
                      <div class="col-md-12">
                        <RadzenLabel Component="Qualite" style="width: 100%" Text="Appartenance">
                        </RadzenLabel>
                        <RadzenDropDown style="width: 100%" TextProperty="Designation" @bind-Value="@(user.Affiliation)" ValueProperty="Designation" Name="Dropdown0">
                        </RadzenDropDown>
                      </div>
                    </div>
                  </ChildContent>
                </RadzenCard>
                <RadzenCard Visible="@(!user.Memberofufas)">
                  <ChildContent>
                    <div style="margin-bottom: 1rem" class="row">
                      <div class="col-md-12">
                        <RadzenLabel Component="Qualite" style="width: 100%" Text="Affiliation">
                        </RadzenLabel>
                        <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(user.Affiliation)" Name="Affiliation">
                        </RadzenTextBox>
                      </div>
                    </div>
                  </ChildContent>
                </RadzenCard>
              </ChildContent>
            </RadzenCard>
            <RadzenCard style="border: 1px solid #000000; border-radius: 10px">
              <ChildContent>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-12">
                    <RadzenLabel Component="Affiliation" style="width: 100%" Text="Mot de passe">
                    </RadzenLabel>
                    <RadzenPassword style="display: block; width: 100%" @bind-Value="@(user.Password)" Name="Password">
                    </RadzenPassword>
                    <RadzenRequiredValidator Component="Password" style="position: absolute" Text="Mot de passe requis">
                    </RadzenRequiredValidator>
                  </div>
                </div>
                <div style="margin-bottom: 1rem" class="row">
                  <div class="col-md-12">
                    <RadzenLabel Component="ConfirmPassword" style="width: 100%" Text="confirmer mot de passe">
                    </RadzenLabel>
                    <RadzenPassword style="display: block; width: 100%" @bind-Value="@(user.ConfirmPassword)" Name="ConfirmPassword">
                    </RadzenPassword>
                    <RadzenRequiredValidator Component="ConfirmPassword" style="position: absolute" Text="Confirmer le mot de passe est requis">
                    </RadzenRequiredValidator>
                  </div>
                </div>
              </ChildContent>
            </RadzenCard>
            <RadzenCard style="border: 1px solid #000000; border-radius: 10px">
              <ChildContent>
                <div class="row">
                  <div class="col  justify-content-around d-flex">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="S'inscrire">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" Text="Annuler" Click="@Button1Click">
                    </RadzenButton>
                  </div>
                </div>
              </ChildContent>
            </RadzenCard>
          </ChildContent>
        </RadzenTemplateForm>
      </div>
    </div>
  </ChildContent>
</RadzenContent>
