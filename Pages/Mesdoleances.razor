@page "/mesdoleances"
@layout MainLayout
@inherits Doleance.Pages.MesdoleancesComponent

@using Radzen
@using Radzen.Blazor
@using Doleance.Models.AppDb
@using Microsoft.AspNetCore.Identity;
@using Doleance.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<PageTitle>Mesdoleances</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <RadzenHeading Size="H2" style="background-color: #598087; border-radius: 10px; color: #e6ecef; text-align: center" Text="Liste des doléances déposées">
    </RadzenHeading>
    <RadzenCard>
      <ChildContent>
        <div class="row">
          <div class="col-md-12 justify-content-center d-flex">
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="send" Text="Soumettre une doléance" Click="@Button1Click">
            </RadzenButton>
          </div>
        </div>
        <RadzenDataList @ref="datalist0" AllowPaging="true" Data="@getDoleanctabsResult" TItem="Doleance.Models.AppDb.Doleanctab" PageSize="5">
          <Template Context="doleanceModelsAppDbDoleanctab">
            <div class="row align-items-center justify-content-between" style="background-color: #3a474d; border-radius: 10px; color: #e6ecef; padding-bottom: 10px; padding-top: 10px">
              <div class="col-md-2">
                <RadzenLabel style="margin-right: 5px" Text="N°">
                </RadzenLabel>
                <RadzenLabel style="font-weight: 800" Text="@($"{(doleanceModelsAppDbDoleanctab.num)}")">
                </RadzenLabel>
              </div>
              <div class="col-md-3">
                <RadzenLabel style="margin-right: 5px" Text="Date">
                </RadzenLabel>
                <RadzenDatePicker DateFormat="d" Disabled="true" style="width: 173px" @bind-Value="@(doleanceModelsAppDbDoleanctab.date)" Name="Datepicker0">
                </RadzenDatePicker>
              </div>
            </div>
            <div class="row align-items-center justify-content-between" style="background-color: #e6ecef; border-radius: 10px; padding-bottom: 10px; padding-top: 10px">
              <div class="col-md-6">
                <RadzenLabel style="margin-right: 5px" Text="Objet">
                </RadzenLabel>
                <RadzenLabel style="font-weight: 800" Text="@($"{(doleanceModelsAppDbDoleanctab.objet)}")">
                </RadzenLabel>
              </div>
              <div class="justify-content-center d-flex col-md-4">
                <RadzenLabel style="margin-right: 5px" Text="Répondu ?">
                </RadzenLabel>
                <RadzenSwitch @bind-Value="@(doleanceModelsAppDbDoleanctab.repondu)" Name="Switch1">
                </RadzenSwitch>
              </div>
            </div>
            <div class="row align-items-center justify-content-center" style="background-color: #e6ecef; border-radius: 10px; padding-bottom: 10px; padding-top: 10px">
              <div class="justify-content-center d-flex col-md-3">
                <RadzenButton Icon="visibility" style="width: 100%" Text="Voir" Click="@((args) =>Button0Click(args, doleanceModelsAppDbDoleanctab))">
                </RadzenButton>
              </div>
            </div>
          </Template>
        </RadzenDataList>
      </ChildContent>
    </RadzenCard>
  </ChildContent>
</RadzenContent>
